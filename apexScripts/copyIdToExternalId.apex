// Query all Account records. Adjust the WHERE clause if you want to filter the records.
List<Account> accountsToUpdate = [SELECT Id FROM Account];

// Iterate through the Account records and set the ExternalId__c field to the Account's Id
for (Account acc : accountsToUpdate) {
    acc.ExternalId__c = acc.Id;
}

// Perform the update in bulk
if (!accountsToUpdate.isEmpty()) {
    update accountsToUpdate;
    System.debug('Successfully updated ' + accountsToUpdate.size() + ' Account records.');
} else {
    System.debug('No Account records to update.');
}