   // get initial data
   useEffect(() => {
      const saveGridPermissions = async (prefs: GridPermission) => {
         try {
            const upsertRec: any = {
               AppGridAg__Grid_Permissions__c: JSON.stringify({ ...prefs }),
            }

            if (gridPermissionsRecId !== '') {
               upsertRec['Id'] = gridPermissionsRecId;
