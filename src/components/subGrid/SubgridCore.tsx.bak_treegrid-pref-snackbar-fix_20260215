              }

              if (!seedColumnState.length) {
                seedColumnState = (gridApiRef.current as any)?.getColumnState?.() || [];
              }

              const store = useStore.getState();
              const payload: any = {
                Name: isTreeSubgridMode ? 'Default Tree View' : 'Default View',
                AppGridAg__SObjectApiName__c: sObjectApiName,
                AppGridAg__Grid_State__c: JSON.stringify((gridApiRef.current as any)?.getState?.() ?? {}),
                AppGridAg__Column_State__c: JSON.stringify(seedColumnState),
                AppGridAg__Calculated_Columns__c: JSON.stringify(store.objCalculatedSubgridColumns || []),
                AppGridAg__Column_Styles__c: JSON.stringify(store.objSubgridColumnStyles || []),
                AppGridAg__Row_Styles__c: JSON.stringify(store.objSubgridRowStyles || []),
                AppGridAg__IsSubgridView__c: true,
                AppGridAg__IsTreegridView__c: isTreeSubgridMode,
                AppGridAg__Pivot_Mode__c: false,
                AppGridAg__FilterOptions__c: JSON.stringify(subgridFilterOptions || []),
                AppGridAg__ShowAdvancedFilter__c: !!showSubgridAdvancedFilter,
                AppGridAg__Parent_Fields__c: parentFieldsJsonRef.current || '',
              };

              const upsertResult = await apiClient.upsertRecs({
                sObjectName: 'AppGridAg__AG_View__c',
                jsonRecs: JSON.stringify([payload]),
              });

              if (!(upsertResult.status === 'success' && upsertResult.results?.[0]?.isSuccess)) {
                throw new Error(`Failed to create default ${isTreeSubgridMode ? 'Tree Grid' : 'Grid'} subgrid view`);
              }

              if (
                createdByThisEffect &&
                isTreeSubgridMode &&
                !modeViewCreateToastShownRef.current.has(modeKey)
              ) {
                modeViewCreateToastShownRef.current.add(modeKey);
                enqueueSnackbar('Default treegrid view created', {
                  action,
                  variant: 'info',
                  autoHideDuration: 3000,
                  preventDuplicate: false,
                  key: `default-subgrid-treegrid-view-created-${modeKey}-${Date.now()}`,
                });
              }
            })();
            modeViewCreateLocksRef.current.set(modeKey, createPromise);
          }

          try {
            await createPromise;
          } finally {
            if (modeViewCreateLocksRef.current.get(modeKey) === createPromise) {
